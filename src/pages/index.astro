---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>🌐 Hi there, traveler!</h1>
			<p>
				Welcome to the official <a href="https://jahnoah.com/">JahNoah</a> blog. This
				platform serves as a fun way to connect and interact with fellow travelers from across the map.
				It is my joy to entage with curious folks from many walks of life while sharing interests.
				Come create woth me!
			</p>
		</main>
		<Footer />
	</body>
</html>
